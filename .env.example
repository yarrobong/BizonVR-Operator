# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_SECRET: required in production for signed Web API bearer tokens. Use a
# random value of at least 32 characters.
# Keep this secret outside the repository. For local-only development, the
# explicit x-user-id fallback is enabled only with ALLOW_DEV_AUTH_FALLBACK=1.
AUTH_SECRET="replace-with-a-long-random-secret"
# ALLOW_DEV_AUTH_FALLBACK="1"

# HUB_PORT: Local port for the Local Hub mini-server that receives Quest Agent heartbeats.
# Use 3001 locally because the cloud backend already uses 3000.
HUB_PORT="3001"

# HUB_HOST: LAN IP of the computer running Local Hub.
# Local Hub can autodetect this, but you can override it if needed.
HUB_HOST="192.168.1.100"

# HUB_TOKEN: shared development credential for Cloud <-> Local Hub command APIs.
# Production can use HUB_TOKENS_JSON with one token per Local Hub id.
HUB_TOKEN="change-me"
# HUB_TOKENS_JSON='{"1":"change-me"}'
# ALLOW_DEV_HUB_AUTH_FALLBACK="1"  # only for an explicitly local, non-production Hub

# COMMAND_STATE_PATH: durable Local Hub command journal/outbox location.
# Default: .cache/local-hub/command-state.sqlite
# COMMAND_STATE_PATH="./.cache/local-hub/command-state.sqlite"

# APK_CACHE_ROOT: approved Local Hub artifact directory. Cloud/UI payloads use
# artifact_id plus SHA-256; arbitrary host filesystem paths are rejected.
APK_CACHE_ROOT="./.cache/local-hub/apks"

# ENABLE_WIRELESS_ADB: Set to 1 after the first trusted USB pairing to keep reconnecting Quest over Wi-Fi ADB.
ENABLE_WIRELESS_ADB="1"

# WIRELESS_CONNECT_RETRY_MS: How often Local Hub retries adb connect for remembered Wi-Fi devices.
WIRELESS_CONNECT_RETRY_MS="15000"

# Casting resource/recovery policy. One producer is shared by all viewers of a Quest.
# MAX_CONCURRENT_CASTS="4"
# MAX_CAST_VIEWERS="4"
# CAST_MAX_PENDING_BYTES="2097152"
# CAST_SLOW_VIEWER_TIMEOUT_MS="5000"
# CAST_NO_VIEWER_STOP_MS="1000"
# CAST_RECOVERY_ATTEMPTS="3"
# CAST_RECOVERY_BASE_DELAY_MS="250"
# CAST_TERM_GRACE_MS="1000"
# CAST_KILL_GRACE_MS="1000"
# ADB_EXECUTABLE="adb"
# FFMPEG_EXECUTABLE="ffmpeg"
# SCRCPY_EXECUTABLE="scrcpy"
