# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HUB_PORT: Local port for the Local Hub mini-server that receives Quest Agent heartbeats.
# Use 3001 locally because the cloud backend already uses 3000.
HUB_PORT="3001"

# HUB_HOST: LAN IP of the computer running Local Hub.
# Local Hub can autodetect this, but you can override it if needed.
HUB_HOST="192.168.1.100"

# QUEST_AGENT_APK_PATH: Optional path to a built Quest APK for INSTALL_APK commands.
QUEST_AGENT_APK_PATH="./quest-agent-spatial-spike/app/build/outputs/apk/debug/app-debug.apk"

# ENABLE_WIRELESS_ADB: Set to 1 after the first trusted USB pairing to keep reconnecting Quest over Wi-Fi ADB.
ENABLE_WIRELESS_ADB="1"

# WIRELESS_CONNECT_RETRY_MS: How often Local Hub retries adb connect for remembered Wi-Fi devices.
WIRELESS_CONNECT_RETRY_MS="15000"
